# herdr-hub roster テンプレート
# 使い方: このファイルを作業対象プロジェクトの cwd に `.herdr-hub.yml` としてコピーし、
# agents の名前・役割を実際の live agent に合わせて書き換える。
# 注意: roster の正は live の agent。ここに書くだけでは agent は起動しない。

defaults:                 # 全 agent の既定値（agent 個別の指定が優先）
  placement: tab          # pane | tab（省略時 tab）
  # transport: herdr      # native 経路を持たない宛先への fallback（実質 herdr のみ有効 —
  #                       # 非 Claude 宛に sendmessage は送れず、非 Codex 宛に codex-queue の
  #                       #  thread は解決しない。native 推定は潰れない）
  # handoff_at: 0.8       # 交代判定の使用率閾値 0–1（省略時 0.8 = 80% 使用で発火）

agents:
  hub:      { role: 統括 }
  reviewer: { role: レビュー専任 }
  worker1:  { role: 実装 }
  # worker2:  { role: 実装, placement: pane, handoff_at: 0.9 }
  # transport の値: herdr | sendmessage | codex-queue | auto
  # （auto = 省略と同じ自動解決の明示値）
