#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = ["pyyaml"]
# ///
import argparse
import dataclasses
import json
import sys
from datetime import UTC, datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from hc_hub_lib.ledger import (
    EVENTS,
    LedgerError,
    LedgerEvent,
    append_event,
    read_events,
)
from hc_hub_lib.roster import (
    Resolved,
    RosterError,
    load_roster,
    resident_names,
    resolve_hub,
    resolve_resident,
    resolve_worker,
)

DEFAULT_ROSTER = ".hc-hub.yml"
ROSTER_ERROR_EXIT = 2


def _resolved_json(r: Resolved) -> str:
    data = dataclasses.asdict(r)
    data["role_def"] = str(r.role_def) if r.role_def is not None else None
    data["rules"] = [str(p) for p in r.rules]
    return json.dumps(data, ensure_ascii=False)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="hc-hub")
    sub = parser.add_subparsers(dest="command", required=True)

    def add_roster(p: argparse.ArgumentParser) -> None:
        p.add_argument("--roster", type=Path, default=Path(DEFAULT_ROSTER))

    add_roster(sub.add_parser("validate", help="roster を検証する"))

    resolve = sub.add_parser(
        "resolve", help="レーンの hub・worker・常駐 agent を解決する"
    )
    add_roster(resolve)
    resolve.add_argument("--lane", required=True)
    target = resolve.add_mutually_exclusive_group(required=True)
    target.add_argument("--hub", action="store_true")
    target.add_argument("--preset")
    target.add_argument("--agent")

    residents = sub.add_parser("residents", help="レーンの常駐 agent 名を出す")
    add_roster(residents)
    residents.add_argument("--lane", required=True)

    ledger = sub.add_parser("ledger", help="台帳へ追記・一覧する")
    ledger_sub = ledger.add_subparsers(dest="ledger_command", required=True)
    append = ledger_sub.add_parser("append", help="台帳へ 1 件追記する")
    add_roster(append)
    for flag in ("lane", "name", "address", "hub"):
        append.add_argument(f"--{flag}", required=True)
    append.add_argument("--event", required=True, choices=EVENTS)
    append.add_argument("--preset")
    append.add_argument("--command-json")
    append.add_argument("--template")
    append.add_argument("--brief")
    listing = ledger_sub.add_parser("list", help="台帳を JSON 配列で出す")
    add_roster(listing)
    listing.add_argument("--lane")
    return parser


def _parse_command_json(raw: str | None) -> tuple[str, ...] | None:
    if raw is None:
        return None
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as e:
        msg = f"--command-json が JSON ではない: {e}"
        raise LedgerError(msg) from e
    if not isinstance(value, list) or not all(isinstance(c, str) for c in value):
        msg = "--command-json は文字列のリスト"
        raise LedgerError(msg)
    return tuple(value)


def run_ledger(args: argparse.Namespace) -> None:
    roster = load_roster(args.roster)
    if args.ledger_command == "list":
        events = read_events(roster.ledger)
        if args.lane is not None:
            events = [e for e in events if e.lane == args.lane]
        print(json.dumps([dataclasses.asdict(e) for e in events], ensure_ascii=False))
        return
    if args.lane not in roster.lanes:
        msg = f"未知のレーン {args.lane!r}（roster: {roster.path}）"
        raise RosterError(msg)
    append_event(
        roster.ledger,
        LedgerEvent(
            ts=datetime.now(UTC).isoformat(timespec="seconds"),
            lane=args.lane,
            name=args.name,
            address=args.address,
            event=args.event,
            hub=args.hub,
            preset=args.preset,
            command=_parse_command_json(args.command_json),
            template=args.template,
            brief=args.brief,
        ),
    )


def run(args: argparse.Namespace) -> None:
    if args.command == "ledger":
        run_ledger(args)
        return
    roster = load_roster(args.roster)
    if args.command == "validate":
        return
    if args.command == "residents":
        print(json.dumps(list(resident_names(roster, args.lane)), ensure_ascii=False))
        return
    if args.hub:
        resolved = resolve_hub(roster, args.lane)
    elif args.preset is not None:
        resolved = resolve_worker(roster, args.lane, args.preset)
    else:
        resolved = resolve_resident(roster, args.lane, args.agent)
    print(_resolved_json(resolved))


def main() -> int:
    args = build_parser().parse_args()
    try:
        run(args)
    except (RosterError, LedgerError) as e:
        print(f"hc-hub: {e}", file=sys.stderr)
        return ROSTER_ERROR_EXIT
    return 0


if __name__ == "__main__":
    sys.exit(main())
