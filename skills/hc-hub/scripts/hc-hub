#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = ["pyyaml"]
# ///
import argparse
import dataclasses
import json
import os
import sys
from datetime import UTC, datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from hc_hub_lib.catalog import KNOWN_AGENTS, CatalogError
from hc_hub_lib.detect import detect_report
from hc_hub_lib.guard import GuardError, check, check_placement_tab
from hc_hub_lib.hc_client import (
    HcError,
    get_labels,
    get_terminal,
    hc_json,
    run_hc,
    terminal_id,
)
from hc_hub_lib.ledger import (
    EVENTS,
    LedgerError,
    LedgerEvent,
    append_event,
    read_events,
)
from hc_hub_lib.preflight import PreflightError, run_preflight
from hc_hub_lib.probe import ProbeError, login_shell, probe_core, probe_shell
from hc_hub_lib.roster import (
    Resolved,
    Roster,
    RosterError,
    load_roster,
    resident_names,
    resolve_hub,
    resolve_resident,
    resolve_worker,
)
from hc_hub_lib.spawn import SpawnError, require_lane_hub, spawn_argv, start_hub
from hc_hub_lib.workspace import (
    WorkspaceError,
    require_main_checkout_top,
    require_not_worker,
)

DEFAULT_ROSTER = ".hc-hub.yml"
ROSTER_ERROR_EXIT = 2


def _resolved_json(r: Resolved) -> str:
    data = dataclasses.asdict(r)
    data["role_def"] = str(r.role_def) if r.role_def is not None else None
    data["rules"] = [str(p) for p in r.rules]
    return json.dumps(data, ensure_ascii=False)


def _add_roster(p: argparse.ArgumentParser) -> None:
    p.add_argument("--roster", type=Path, default=Path(DEFAULT_ROSTER))


def _add_hc(p: argparse.ArgumentParser) -> None:
    p.add_argument("--hc", default="hc")


def add_hc_subcommands(
    sub: "argparse._SubParsersAction[argparse.ArgumentParser]",
) -> None:
    guard = sub.add_parser("guard", help="操作前にレーンの隔離を検査する")
    _add_hc(guard)
    guard.add_argument("--op", required=True)
    guard.add_argument("target")

    space = sub.add_parser("space", help="自分の herdr.space を出す")
    _add_hc(space)

    sub.add_parser("preflight", help="hc の前提を検査する")

    detect = sub.add_parser("detect", help="エージェントが使えるかを判定する")
    _add_hc(detect)

    start = sub.add_parser("start", help="自分を hub としてラベル付けする")
    _add_roster(start)
    _add_hc(start)
    start.add_argument("--lane", required=True)

    spawn = sub.add_parser("spawn-argv", help="worker の hc run 引数を JSON で出す")
    _add_roster(spawn)
    _add_hc(spawn)
    spawn.add_argument("--lane", required=True)
    who = spawn.add_mutually_exclusive_group(required=True)
    who.add_argument("--preset")
    who.add_argument("--agent")
    spawn.add_argument("--name", required=True)
    spawn.add_argument("--task", required=True)
    spawn.add_argument("--brief")
    spawn.add_argument("--cwd", type=Path, required=True)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="hc-hub")
    sub = parser.add_subparsers(dest="command", required=True)

    def add_roster(p: argparse.ArgumentParser) -> None:
        p.add_argument("--roster", type=Path, default=Path(DEFAULT_ROSTER))

    add_roster(sub.add_parser("validate", help="roster を検証する"))

    resolve = sub.add_parser(
        "resolve", help="レーンの hub・worker・常駐 agent を解決する"
    )
    add_roster(resolve)
    resolve.add_argument("--lane", required=True)
    target = resolve.add_mutually_exclusive_group(required=True)
    target.add_argument("--hub", action="store_true")
    target.add_argument("--preset")
    target.add_argument("--agent")

    residents = sub.add_parser("residents", help="レーンの常駐 agent 名を出す")
    add_roster(residents)
    residents.add_argument("--lane", required=True)

    ledger = sub.add_parser("ledger", help="台帳へ追記・一覧する")
    ledger_sub = ledger.add_subparsers(dest="ledger_command", required=True)
    append = ledger_sub.add_parser("append", help="台帳へ 1 件追記する")
    add_roster(append)
    _add_hc(append)
    for flag in ("lane", "name", "address", "hub"):
        append.add_argument(f"--{flag}", required=True)
    append.add_argument("--event", required=True, choices=EVENTS)
    append.add_argument("--preset")
    append.add_argument("--command-json")
    append.add_argument("--template")
    append.add_argument("--brief")
    listing = ledger_sub.add_parser("list", help="台帳を JSON 配列で出す")
    add_roster(listing)
    listing.add_argument("--lane")

    add_hc_subcommands(sub)
    return parser


def _parse_command_json(raw: str | None) -> tuple[str, ...] | None:
    if raw is None:
        return None
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as e:
        msg = f"--command-json が JSON ではない: {e}"
        raise LedgerError(msg) from e
    if (
        not isinstance(value, list)
        or not value
        or not all(isinstance(c, str) and c for c in value)
    ):
        msg = "--command-json は空でない文字列のリスト"
        raise LedgerError(msg)
    return tuple(value)


def _check_append_args(args: argparse.Namespace, roster: Roster) -> None:
    for flag in ("name", "address", "hub"):
        if not getattr(args, flag):
            msg = f"--{flag} は空でない文字列"
            raise LedgerError(msg)
    if args.template is not None and not args.template:
        msg = "--template は空でない文字列"
        raise LedgerError(msg)
    if args.preset is not None and args.preset not in roster.raw.get("presets", {}):
        msg = f"--preset {args.preset!r} は roster に定義された preset でない"
        raise RosterError(msg)


def run_ledger(args: argparse.Namespace) -> None:
    roster = load_roster(args.roster)
    if args.ledger_command == "list":
        events = read_events(roster.ledger)
        if args.lane is not None:
            events = [e for e in events if e.lane == args.lane]
        print(json.dumps([dataclasses.asdict(e) for e in events], ensure_ascii=False))
        return
    if args.lane not in roster.lanes:
        msg = f"未知のレーン {args.lane!r}（roster: {roster.path}）"
        raise RosterError(msg)
    _check_append_args(args, roster)
    command = _parse_command_json(args.command_json)
    # 他レーンの台帳記録を防ぐため、自分がそのレーンの hub であることを確かめる
    me = terminal_id(os.environ)
    require_lane_hub(get_labels(args.hc, me), args.lane)
    if args.hub != me:
        msg = f"--hub {args.hub!r} が自分のアドレス {me!r} と違う"
        raise LedgerError(msg)
    append_event(
        roster.ledger,
        LedgerEvent(
            ts=datetime.now(UTC).isoformat(timespec="seconds"),
            lane=args.lane,
            name=args.name,
            address=args.address,
            event=args.event,
            hub=args.hub,
            preset=args.preset,
            command=command,
            template=args.template,
            brief=args.brief,
        ),
    )


def run_start(args: argparse.Namespace, me: str) -> None:
    roster = load_roster(args.roster)
    listing = hc_json(
        args.hc,
        [
            "ls",
            "--label",
            f"hc-hub.lane={args.lane}",
            "--label",
            "hc-hub.role=hub",
            "--json",
        ],
    )
    rows = listing.get("terminals")
    if not isinstance(rows, list):
        msg = "hc ls --json に terminals の配列が無い"
        raise HcError(msg)
    addresses = []
    for row in rows:
        address = row.get("address") if isinstance(row, dict) else None
        if not isinstance(address, str):
            msg = f"hc ls --json の行に文字列の address が無い: {row!r}"
            raise HcError(msg)
        addresses.append(address)
    hubs = [get_terminal(args.hc, a) for a in addresses]
    run_hc(args.hc, ["label", me, *start_hub(roster, args.lane, me, hubs)])


def run_spawn_argv(args: argparse.Namespace, me: str) -> None:
    roster = load_roster(args.roster)
    if args.preset is not None:
        resolved = resolve_worker(roster, args.lane, args.preset)
        role = args.preset
    else:
        resolved = resolve_resident(roster, args.lane, args.agent)
        role = args.agent
    argv = spawn_argv(
        resolved,
        args.lane,
        args.name,
        args.task,
        get_labels(args.hc, me),
        args.brief,
        role=role,
        cwd=args.cwd,
    )
    print(json.dumps(argv, ensure_ascii=False))


def run_detect(args: argparse.Namespace, me: str) -> None:
    top = require_main_checkout_top(Path.cwd())
    require_not_worker(get_labels(args.hc, me))
    executables = [a.executable for a in KNOWN_AGENTS]
    core = probe_core(args.hc, executables, top)
    shell_path = login_shell()
    shell = probe_shell(shell_path, executables)
    print(json.dumps(detect_report(core, shell, shell_path), ensure_ascii=False))


def run_hc_commands(args: argparse.Namespace) -> None:
    if args.command == "preflight":
        run_preflight(os.environ)
        return
    me = terminal_id(os.environ)
    if args.command == "guard":
        check(args.op, get_labels(args.hc, me), get_labels(args.hc, args.target))
    elif args.command == "space":
        print(check_placement_tab(get_labels(args.hc, me)))
    elif args.command == "detect":
        run_detect(args, me)
    elif args.command == "start":
        run_start(args, me)
    else:
        run_spawn_argv(args, me)


def run(args: argparse.Namespace) -> None:
    if args.command == "ledger":
        run_ledger(args)
        return
    if args.command in ("guard", "space", "preflight", "start", "spawn-argv", "detect"):
        run_hc_commands(args)
        return
    roster = load_roster(args.roster)
    if args.command == "validate":
        return
    if args.command == "residents":
        print(json.dumps(list(resident_names(roster, args.lane)), ensure_ascii=False))
        return
    if args.hub:
        resolved = resolve_hub(roster, args.lane)
    elif args.preset is not None:
        resolved = resolve_worker(roster, args.lane, args.preset)
    else:
        resolved = resolve_resident(roster, args.lane, args.agent)
    print(_resolved_json(resolved))


def main() -> int:
    args = build_parser().parse_args()
    try:
        run(args)
    except (
        RosterError,
        LedgerError,
        GuardError,
        PreflightError,
        SpawnError,
        HcError,
        ProbeError,
        WorkspaceError,
        CatalogError,
    ) as e:
        print(f"hc-hub: {e}", file=sys.stderr)
        return ROSTER_ERROR_EXIT
    return 0


if __name__ == "__main__":
    sys.exit(main())
